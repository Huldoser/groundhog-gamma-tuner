# Python bytecode
__pycache__/

# Virtual Environment
venv/
.venv/

# IDE specific folders
.vscode/
.idea/

# Live miner list and learned setpoints. The app creates config.json if it is missing.
config.json
.config-*.json
# Except the snapshot each release keeps (tools/snapshot_release.py).
!test_fixtures/released/*/config.json
# Ten-minute history for the History screen. The app creates it.
history.db
history.db-journal
!test_fixtures/released/*/history.db

# Local logs and secrets
*.log
.env

# PyInstaller output
build/
dist/

# Copies of config.json kept before an update adds settings to it.
config.backup-*.json

# Test coverage data
.coverage
.coverage.*
htmlcov/
